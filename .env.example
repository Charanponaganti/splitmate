# ---------------------------------------------------------------------------
# SplitMate configuration. Copy to `.env.local` for local development.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Public URL of the app (used for auth callbacks and invite links).
BETTER_AUTH_URL=http://localhost:3000

# Random secret used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production.
BETTER_AUTH_SECRET=

# Database.
#   - Leave unset (or use pglite:./.data/pglite) for the zero-setup embedded
#     Postgres used in local development.
#   - In production use a real Postgres connection string, e.g. Neon,
#     Supabase (direct/session connection, port 5432), RDS or Railway.
#     Live updates use LISTEN/NOTIFY, which needs a direct or session-mode
#     connection — not a transaction-mode pooler.
# DATABASE_URL=postgres://user:password@host:5432/splitmate?sslmode=require
# DATABASE_POOL_SIZE=10

# Optional: Google sign-in. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
#   {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: send invitation emails through Resend (https://resend.com).
# Without these, invitations still work via shareable links.
RESEND_API_KEY=
EMAIL_FROM="SplitMate <invites@yourdomain.com>"

# Optional: extra origins allowed to call the auth API (comma separated),
# e.g. your LAN address when testing on a phone: http://192.168.1.20:3000
TRUSTED_ORIGINS=
# Allow those LAN origins in `next dev` too (host only, comma separated).
ALLOWED_DEV_ORIGINS=

# Optional: rename the app.
NEXT_PUBLIC_APP_NAME=SplitMate
