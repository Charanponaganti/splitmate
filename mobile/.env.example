# Default SplitMate server baked into the APK. Users can change it on the sign-in screen.
# Use your PC's Wi-Fi IP for local testing (e.g. http://192.168.1.50:3000) or your deployed https URL.
# Public value only: never put secrets in EXPO_PUBLIC_* variables, they ship inside the app.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000
